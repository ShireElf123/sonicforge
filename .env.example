# Server configuration
PORT=3000
NODE_ENV=development

# AI Mastering Co-Pilot & Diagnostic Waterfall (ALL OPTIONAL — works with zero keys out of the box!)
# When no keys are configured, SonicForge Pro automatically uses:
#   1) Zero-Key Free Cloud LLM -> SonicForge Built-In Acoustic Neural-Heuristic Engine v2
#   2) 100% Browser-Resident Neural LLM (@huggingface/transformers WebGPU/WASM SmolLM2 + Chrome window.ai)
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: HMAC secret for signing server-verified session tokens
SESSION_HMAC_SECRET=replace-with-32-byte-random-production-secret
